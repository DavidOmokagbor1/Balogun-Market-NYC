# ── Anthropic (provenance narratives, image-to-catalog) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (embeddings for semantic search) ──
OPENAI_API_KEY=sk-...

# ── Supabase (Postgres + pgvector + Storage) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only: used by API routes for writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Shopify (headless storefront, cart, hosted checkout) ──
# Install Shopify's Headless sales channel and create a storefront token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_API_VERSION=2026-07
