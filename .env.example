# ── Site URL (Open Graph, sitemap). Production storefront after Dynadot:
# NEXT_PUBLIC_SITE_URL=https://www.balogunmarketnyc.com
# Keep checkout on balogunmarketnyc.com (Shopify). Do not point the apex at Vercel.
NEXT_PUBLIC_SITE_URL=https://balogun-market-nyc.vercel.app

# ── Supabase (designer content; not required for Shopify checkout) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only: used by API routes for writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Shopify (headless storefront, cart, hosted checkout) ──
# Domain must be the .myshopify.com host — not the admin.shopify.com Headless URL.
# Publish products to the Headless sales channel or they will not appear on /shop.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_API_VERSION=2026-07
# Hosted checkout hostname (Shopify primary domain). Leave as the apex.
SHOPIFY_CHECKOUT_HOST=balogunmarketnyc.com
